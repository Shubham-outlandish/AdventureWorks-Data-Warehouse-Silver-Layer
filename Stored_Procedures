CREATE PROCEDURE [dbo].[Create_Execution_Log_Table]
as
begin
CREATE TABLE dbo.Execution_Log (
    session_id UNIQUEIDENTIFIER NOT NULL,
    execution_id UNIQUEIDENTIFIER PRIMARY KEY,
    procedure_name NVARCHAR(100) NOT NULL,
    sequence_no INT NOT NULL,
    start_time DATETIME NOT NULL DEFAULT GETDATE(),
    end_time DATETIME NULL,
    status NVARCHAR(20) NOT NULL,
    error_message NVARCHAR(MAX) NULL,

    FOREIGN KEY (session_id)
    REFERENCES adventureworks_silver.dbo.session_log (session_id)
    )
end
