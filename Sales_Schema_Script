CREATE view [sales].[Product_Offers] as
select
        sop.ProductID
       ,p.Name
       ,p.StandardCost
       ,p.ListPrice
       ,so.DiscountPct
       ,so.Description
       ,so.MinQty
       ,coalesce(so.maxqty,0) as MaxQty
       ,so.Type
       ,so.Category
       ,so.StartDate
       ,so.EndDate
       ,so.rowguid
       ,so.ModifiedDate
from adventureworks2019.Sales.SpecialOfferProduct as sop
join adventureworks2019.Production.Product as p 
on sop.ProductID=p.ProductID
left join adventureworks2019.Sales.SpecialOffer as so
on so.SpecialOfferID=sop.SpecialOfferID

