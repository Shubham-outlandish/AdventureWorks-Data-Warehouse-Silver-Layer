CREATE view [sales].[Payment_details] as

with PersonDetails AS (
SELECT 
    p.BusinessEntityID as personid
    ,concat_ws(p.Title,' ', p.FirstName,' ', p.[MiddleName],' ',p.[LastName]) as Person_name
    ,p.PersonType
    ,a.City
    ,a.PostalCode
    ,sp.Name AS StateName
    ,cr.Name AS CountryName
FROM adventureworks2019.Person.Person p
left JOIN adventureworks2019.Person.BusinessEntityAddress bea 
    ON p.BusinessEntityID = bea.BusinessEntityID
left JOIN adventureworks2019.Person.Address a 
    ON bea.AddressID = a.AddressID
left JOIN adventureworks2019.Person.StateProvince sp 
    ON a.StateProvinceID = sp.StateProvinceID
left JOIN adventureworks2019.Person.CountryRegion cr 
    ON sp.CountryRegionCode = cr.CountryRegionCode)

select 
       pcc.BusinessEntityID as Personid
      ,pd.PersonType
      ,pd.Person_name
      ,pd.City
      ,pd.StateName
      ,pd.CountryName
      ,cc.[CreditCardID]
      ,cc.[CardType]
      ,cc.[CardNumber]
      ,cc.[ExpMonth]
      ,cc.[ExpYear]
      ,cc.[ModifiedDate]
from adventureworks2019.Sales.PersonCreditCard as pcc
join PersonDetails as pd
on pcc.BusinessEntityID=pd.personid
left join adventureworks2019.Sales.CreditCard as cc
on cc.CreditCardID=pcc.CreditCardID
GO
