       p.ProductID
      ,i.illustrationID
      ,pd.productDescriptionID
      ,c.cultureID
      ,p.Name
      ,pm.[ProductModelID]
      ,pm.[Name] as Model_name
      ,Cast(i.Diagram as nvarchar(max)) as XML_Diagram
