CREATE VIEW [HumanResources].[Employee] as 
select 
-- Taking from employees
e.[BusinessEntityID],
edh.[DepartmentID],
edh.[ShiftID],

--taking From Empoyees department history
edh.[StartDate] as [Joining_StartDate],
edh.[EndDate],
e.[LoginID],
e.[NationalIDNumber],
e.[OrganizationNode],
e.[OrganizationLevel],
e.[JobTitle],
e.[BirthDate],
e.[MaritalStatus],
e.[Gender],
e.[HireDate],
e.[VacationHours],
e.[SickLeaveHours],

-- taking from shift
sh.[Name] as [ShiftName],
sh.[StartTime] as [Shift_StartTime],
sh.[EndTime] as [Shift_EndTime],

 --taking from Department
d.[Name] as [Department_Name],
d.[GroupName]  as [DepartmentGroupName],
 
 --taking from Employees pay history
eph.[RateChangeDate],
eph.[Rate],
eph.[PayFrequency],
e.[ModifiedDate]
from [AdventureWorks2019].[HumanResources].[Employee] e
left join [AdventureWorks2019].[HumanResources].[EmployeeDepartmentHistory]edh
on e.BusinessEntityID = edh.BusinessEntityID
left join [AdventureWorks2019].[HumanResources].[Department]d
on edh.DepartmentID = d.DepartmentID
left join [AdventureWorks2019].[HumanResources].[Shift]sh
on edh.ShiftID = sh.ShiftID 
