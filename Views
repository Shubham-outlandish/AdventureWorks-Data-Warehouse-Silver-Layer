CREATE view [sales].[Customer_Demographics] as 

with PersonAddress AS (
SELECT 
     p.BusinessEntityID as personid
    ,bea.businessEntityID as BuinessEntityAddressID
    ,sp.StateProvinceID
    ,cr.countryRegionCode
    ,concat_ws(p.Title,' ', p.FirstName,' ', p.[MiddleName],' ',p.[LastName]) as Person_name
    ,a.City
    ,a.PostalCode
    ,sp.Name AS StateName
    ,cr.Name AS CountryName
FROM adventureworks2019.Person.Person p
JOIN adventureworks2019.Person.BusinessEntityAddress bea 
    ON p.BusinessEntityID = bea.BusinessEntityID
JOIN adventureworks2019.Person.Address a 
    ON bea.AddressID = a.AddressID
JOIN adventureworks2019.Person.StateProvince sp 
    ON a.StateProvinceID = sp.StateProvinceID
JOIN adventureworks2019.Person.CountryRegion cr 
    ON sp.CountryRegionCode = cr.CountryRegionCode)

select 
       c.[CustomerID]
      ,pav.[personid]
      ,pav.BuinessEntityAddressID
      ,pav.StateProvinceID
      ,st.territoryID
      ,c.storeID
      ,pav.[Person_name]
      ,pav.[City]
      ,pav.[PostalCode]
      ,pav.[StateName]
      ,pav.[CountryName]
      ,st.[Name] as TerritoryName
      ,st.[CountryRegionCode]
      ,st.[Group]      
      ,c.[AccountNumber]     
      ,s.[Name] as Store_name
      ,s.[SalesPersonID]
      ,sp.[Person_name] as Sales_Person
      ,s.[ModifiedDate] as Store_Modified_date
      ,c.[rowguid]
      ,c.[ModifiedDate]
    FROM [adventureworks2019].[Sales].[Customer] as c
  left join adventureworks2019.sales.SalesTerritory as st
  on c.TerritoryID=st.TerritoryID
  left join [adventureworks2019].[Sales].[Store] as s
  on s.BusinessEntityID=c.StoreID
  left join adventureworks2019.Person.Person as p
  on c.PersonID=p.BusinessEntityID
  left join PersonAddress as pav
  on pav.personid=c.PersonID
  left join PersonAddress as sp
  on sp.personid=s.salespersonid
