CREATE view [sales].[SalesPerson_Details] as

    with PersonAddress AS (
SELECT 
     p.BusinessEntityID as personid
    ,bea.businessEntityID as BuinessEntityAddressID
    ,sp.StateProvinceID
    ,concat_ws(' ',p.Title,' ', p.FirstName,' ', p.[MiddleName],' ',p.[LastName]) as Person_name
    ,a.City
    ,a.PostalCode
    ,sp.Name AS StateName
    ,cr.Name AS CountryName
FROM adventureworks2019.Person.Person p
JOIN adventureworks2019.Person.BusinessEntityAddress bea 
    ON p.BusinessEntityID = bea.BusinessEntityID
JOIN adventureworks2019.Person.Address a 
    ON bea.AddressID = a.AddressID
JOIN adventureworks2019.Person.StateProvince sp 
    ON a.StateProvinceID = sp.StateProvinceID
JOIN adventureworks2019.Person.CountryRegion cr 
    ON sp.CountryRegionCode = cr.CountryRegionCode),

state_tax as (
select 
        sp.StateProvinceID
       ,sp.TerritoryID
       ,st.TaxRate
       ,st.Name as Tax_name
from  adventureworks2019.person.StateProvince as sp
join adventureworks2019.Sales.salestaxrate as st
on st.StateProvinceID=sp.StateProvinceID)

select 
       sp.BusinessEntityID as SalesPersonid
      ,pa.personid
      ,pa.BuinessEntityAddressID
      ,pa.StateProvinceID
      ,st.territoryID
      ,pa.person_name as SalesPerson
      ,s.name as Storename
      ,st.[name] as Territory
      ,st.[CountryRegionCode]
      ,coalesce(sp.[SalesQuota],0) as SalesQuota
      ,sp.[Bonus]
      ,sp.[CommissionPct]
      ,sp.[SalesYTD]
      ,sp.[SalesLastYear]
      ,coalesce(state_tax.[TaxRate],0) as TaxRate
      ,state_tax.[Tax_name]
from adventureworks2019.Sales.SalesPerson as sp
left join adventureworks2019.Sales.Store as s
on sp.BusinessEntityID=s.SalesPersonID
left join adventureworks2019.Sales.SalesPersonQuotaHistory as spqh
on spqh.BusinessEntityID=sp.BusinessEntityID
left join adventureworks2019.Sales.Salesterritory as st
on st.TerritoryID=sp.TerritoryID
left join personAddress as pa
on pa.personid=sp.BusinessEntityID
left join state_tax 
on state_tax.TerritoryID=sp.TerritoryID



