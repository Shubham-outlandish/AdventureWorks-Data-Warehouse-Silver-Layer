CREATE view [production].[Product] as 
select p.[ProductID]
      ,psc.productSubCategoryID
      ,pc.ProductCategoryID
      ,pp.productPhotoID
      ,p.[Name]
      ,p.[ProductNumber]
      ,p.[MakeFlag]
      ,p.[FinishedGoodsFlag]
      ,p.[Color]
      ,p.[SafetyStockLevel]
      ,p.[ReorderPoint]
      ,p.[StandardCost]
      ,p.[ListPrice]
      ,p.[Size]
      ,Size_um.[name] as Size_Unit
      ,p.[Weight]
      ,Weight_um.[name] as Weight_Unite
      ,psc.Name as Sub_Category
      ,pc.Name as Category
      ,ppp.[Primary]
      ,pp.[ThumbNailPhoto]
      ,pp.[ThumbnailPhotoFileName]
      ,pp.[LargePhoto]
      ,pp.[LargePhotoFileName]
      ,p.[DaysToManufacture]
      ,p.[ProductLine]
      ,p.[Class]
      ,p.[Style]
      ,p.[SellStartDate]
      ,p.[SellEndDate]
      ,p.[DiscontinuedDate]
      ,p.[rowguid]
      ,p.[ModifiedDate]
  FROM [adventureworks2019].[Production].[Product] as p                         -- product
  left join [adventureworks2019].[Production].[ProductSubcategory] as psc       -- Product Sub Category
  on p.ProductSubcategoryID=psc.ProductSubcategoryID
  left join [adventureworks2019].[Production].[ProductCategory] as pc           -- Product Category
  on pc.ProductCategoryID=psc.ProductCategoryID
  left join[AdventureWorks2019].[Production].[ProductProductPhoto] ppp         --ProductProductPhoto
  on p.ProductID = ppp.ProductID 
  left join [AdventureWorks2019].[Production].[ProductPhoto]pp                --ProductPhoto
  on ppp.ProductPhotoID = pp.ProductPhotoID 
  left join [adventureworks2019].[Production].[UnitMeasure] as Size_um          -- Uit
  on Size_um.UnitMeasureCode=p.SizeUnitMeasureCode
  left join [adventureworks2019].[Production].[UnitMeasure] as Weight_um
  on Weight_um.UnitMeasureCode=p.WeightUnitMeasureCode
